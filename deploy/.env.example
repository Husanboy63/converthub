# Replaced with the exact image tag by scripts/build-release.sh.
CONVERT_IMAGE=convert:local
# If Nginx Proxy Manager is on another VM/LXC, use this VM's private IP.
BIND_ADDRESS=127.0.0.1
HTTP_PORT=3000
MAX_FILE_SIZE_MB=50
MAX_FILES_PER_JOB=50
QUEUE_CONCURRENCY=2
FILE_TTL_HOURS=2
# Includes UI polling. Behind a proxy the current app shares one IP limit.
RATE_LIMIT_PER_MIN=600
CPU_LIMIT=2.0
MEMORY_LIMIT=3g
